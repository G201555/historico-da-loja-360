{
  "hosting": [
    {
      "target": "principal",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "tools/**"
      ],
      "headers": [
        {
          "source": "index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "roku360",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "tools/**"
      ],
      "headers": [
        {
          "source": "index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
